  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>wallet</keyword>
    <keyword>boarding pass</keyword>
    <keyword>ticket</keyword>
  </keywords>
